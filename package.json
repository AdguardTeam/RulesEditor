{
  "name": "@adguard/rules-editor",
  "version": "2.0.0",
  "description": "User rules text editor based on Codemirror and AdGuard textmate highlight",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "author": "AdGuard",
  "license": "GPL-3.0-only",
  "scripts": {
    "update-grammars": "tsx ./scripts/update-grammars.mts",
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "rspack",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "demo": "rspack serve --config demo/rspack.config.ts",
    "lint:code": "eslint --cache .",
    "lint:types": "tsc",
    "lint": "pnpm run lint:code && pnpm run lint:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky install",
    "increment": "pnpm version patch --no-git-tag-version"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.33.4 <11"
  },
  "dependencies": {
    "style-mod": "4.1.3",
    "vscode-textmate": "9.3.2"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@codemirror/commands": "6.10.3",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "@lezer/highlight": "1.2.3",
    "@rsdoctor/rspack-plugin": "1.5.13",
    "@rspack/cli": "2.0.8",
    "@rspack/core": "2.0.8",
    "@rspack/dev-server": "2.0.3",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.16.2",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-jsdoc": "^63.0.6",
    "eslint-plugin-n": "^18.1.0",
    "husky": "8.0.3",
    "jsdoc": "^4.0.5",
    "jsdom": "29.1.1",
    "oniguruma-parser": "0.12.2",
    "ts-loader": "9.4.4",
    "tsx": "4.22.4",
    "typescript": "5.2.2",
    "vitest": "4.1.8",
    "vscode-oniguruma": "2.0.1",
    "yaml": "2.9.0"
  }
}
