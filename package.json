{
  "name": "@adguard/rules-editor",
  "version": "1.3.3",
  "description": "User rules text editor based on Codemirror and AdGuard textmate highlight",
  "main": "dist/index.js",
  "types": "dist/types",
  "author": "AdGuard",
  "license": "GPL-3.0-only",
  "scripts": {
    "loadGrammar": "ts-node --project ./tsconfig.json ./scripts/loadAdGuardGrammar.ts",
    "build": "webpack",
    "lint:code": "eslint --cache .",
    "lint:types": "tsc",
    "lint": "pnpm run lint:code && pnpm run lint:types",
    "test": "jest",
    "prepare": "husky install",
    "increment": "pnpm version patch --no-git-tag-version"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.33.4 <11"
  },
  "dependencies": {
    "@adguard/tsurlfilter": "^2.1.12",
    "@types/codemirror": "^5.60.10",
    "codemirror": "^5.65.15",
    "codemirror-textmate": "^1.1.0",
    "is-valid-domain": "^0.1.6",
    "onigasm": "^2.2.5",
    "path-browserify": "^1.0.1",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^29.5.5",
    "@types/js-yaml": "^4.0.7",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "^10.5.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.16.2",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-jsdoc": "^63.0.6",
    "eslint-plugin-n": "^18.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "jsdoc": "^4.0.5",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
