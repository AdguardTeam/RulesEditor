{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        // With this tsconfig, we don't need to emit any files,
        // we just want to check the types
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "scripts/**/*.mts",
        "test/**/*.ts",
        "demo/**/*.ts",
        "**/.eslintrc.cjs",
        "vitest.config.ts",
        "rspack.config.ts",
    ],
}
