{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        // With this tsconfig, we don't need to emit any files,
        // we just want to check the types
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["jest", "node"]
    },
    "include": [
        "declaration.d.ts",
        "src/**/*.ts",
        "test/**/*.ts",
        "scripts/**/*.ts",
        "eslint.config.mjs",
        "jest.config.js",
        "webpack.config.js",
    ],
}
